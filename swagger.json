  "info": {
    "title": "LMS Backend API",
    "description": "NestJS REST API documentation for LMS Backend Management System",
    "version": "2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "Authorization",
        "description": "Enter JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "AddUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "Full name of the user"
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com",
            "description": "Email address of the user"
          },
          "password": {
            "type": "string",
            "example": "Pass@1234",
            "description": "User password (at least 8 characters, one alphabet, one number, and one special character)"
          },
          "role": {
            "type": "string",
            "example": "student",
            "enum": [
              "student",
              "faculty",
              "admin"
            ],
            "description": "User role"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1",
            "description": "Unique user identifier"
          },
          "roll_no": {
            "type": "string",
            "example": "STU001",
            "description": "User roll number"
          },
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "User full name"
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com",
            "description": "User email"
          },
          "role": {
            "type": "string",
            "example": "admin",
            "description": "User role"
          }
        },
        "required": [
          "id",
          "roll_no",
          "name",
          "email"
        ]
      },
      "AuthenticateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "john.doe@example.com",
            "description": "User email or roll number"
          },
          "password": {
            "type": "string",
            "example": "Pass@1234",
            "description": "User password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserAuthTokenResponseDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "description": "JWT Authentication Bearer token"
          },
          "role": {
            "type": "string",
            "example": "admin",
            "description": "User role"
          },
          "data": {
            "description": "Authenticated user info",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserResponseDto"
              }
            ]
          }
        },
        "required": [
          "token",
          "data"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "object",
            "example": 1,
            "description": "User ID to update"
          },
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "Updated full name"
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com",
            "description": "Updated email address"
          },
          "password": {
            "type": "string",
            "example": "Pass@1234",
            "description": "Updated password"
          },
          "phone": {
            "type": "string",
            "example": "9876543210",
            "description": "10-digit mobile phone number"
          },
          "status": {
            "type": "string",
            "example": "Active",
            "description": "User status (Active, Inactive, Deactive, Pending)"
          }
        },
        "required": [
          "id"
        ]
      },
      "ChangeUserStatusDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "object",
            "example": 1,
            "description": "User ID"
          },
          "status": {
            "type": "string",
            "example": "Active",
            "description": "User status (Active, Inactive, Deactive, Pending)"
          }
        },
        "required": [
          "id",
          "status"
        ]
      },
      "UpdatePasswordSelfDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "object",
            "example": 1,
            "description": "Optional user ID (extracted automatically from JWT token if logged in)"
          },
          "uid": {
            "type": "object",
            "example": 1,
            "description": "Optional user ID alias"
          },
          "password": {
            "type": "string",
            "example": "Pass@1234",
            "description": "New password (at least 8 characters, one alphabet, one number, and one special character)"
          }
        },
        "required": [
          "password"
        ]
      },
      "AddNotificationDto": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "number",
            "example": 1,
            "description": "Target user ID"
          },
          "title": {
            "type": "string",
            "example": "Assignment Reminder",
            "description": "Notification title"
          },
          "message": {
            "type": "string",
            "example": "Your Math assignment is due tomorrow at 5 PM.",
            "description": "Notification message text"
          },
          "type": {
            "type": "string",
            "example": "info",
            "description": "Type of notification (e.g., info, warning, alert)"
          }
        },
        "required": [
          "user_id",
          "title",
          "message"
        ]
      },
      "MarkAsReadDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1,
            "description": "Notification ID to mark as read"
          }
        },
        "required": [
          "id"
        ]
      },
      "MarkAllAsReadDto": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "number",
            "example": 1,
            "description": "User ID whose notifications to mark as read"
          }
        },
        "required": [
          "user_id"
        ]
      },
      "UpdateNotificationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1,
            "description": "Notification ID"
          },
          "title": {
            "type": "string",
            "example": "Updated Assignment Reminder",
            "description": "Updated notification title"
          },
          "message": {
            "type": "string",
            "example": "Your Math assignment submission time has been extended.",
            "description": "Updated message"
          },
          "type": {
            "type": "string",
            "example": "info",
            "description": "Notification type"
          }
        },
        "required": [
          "id",
          "title",
          "message"
        ]
      }
    }
  }
}